# Exclude virtual environments
.venv

# Exclude Terraform-related files
.terraform
.terraform.lock.hcl
*.tfstate
*.tfstate.backup

# Exclude Git-related files
.git
.gitignore

# Exclude logs and caches
*.log
__pycache__/
*.pyc
*.pyo
*.pyd
*.swp


# Exclude other unnecessary files
.cadence/
docs/
_merged_scripts/

# Exclude all contents
experiments/**
# Allow the .gitkeep file
!experiments/.gitkeep

# Allow specific subfolders in experiments
#!experiments/weatherstation/TCN_weatherstation_168_24_0.30_0.10_0.10_20250202-202941/**
#!experiments/weatherstation/TCN_weatherstation_168_24_0.60_0.10_0.10_20250203-031139/**

/scripts/
/results/

# IMPROVEMENT
# .ENV must be excluded from .dockerignore since not all settings are overwritten by Dockerfile
#.env
*.DS_Store

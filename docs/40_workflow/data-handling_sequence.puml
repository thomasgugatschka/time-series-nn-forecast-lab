@startuml

title Sequence Diagram for Data Handling

participant "Script" as User
participant "DataManager" as DM
participant "RawDataLoader" as RDL
participant "DataPipelineFactory" as DPF
participant "DataPipeline" as Pipeline
participant "DataTransformation" as DT
participant "DataSplitter" as DS
participant "DataLoaderCreator" as DLC


User -> DM: Request Data Preparation
DM -> RDL: Load Raw Data
RDL -> DM: Return Raw Data
User -> DM: Request Data Preprocessing
DM -> DPF: Create Data Pipeline (based on Model Type)

DPF -> Pipeline: Create Pipeline
Pipeline -> DM: Pipeline Instance


DM -> Pipeline: Preprocess Data
Pipeline -> Pipeline: Crop
Pipeline -> DT: Normalize
Pipeline <- DT: Return Normalized Data
Pipeline -> Pipeline: Calculate Features
Pipeline -> Pipeline: Generate TimeSeries Windows
Pipeline -> DS: Split Data
DS -> Pipeline: Return Split Data
Pipeline -> Pipeline: Convert to Tensors
DM <- Pipeline: Return Data

User <- DM: Return Preprocessed Data

User -> User: Read Configuration

User -> DM: Request Data Loader (train, val, test)
DM -> DLC: Create DataLoaders (train, val, test)
DLC -> DM: Return DataLoaders
User <- DM: Return DataLoaders


@enduml

@startuml

title Training Sequence Diagram

actor "User" as User

participant "Main Script" as Main
participant "ConfigManager" as ConfigManager
participant "DataManager" as DataManager
participant "ExperimentManager" as ExperimentManager
participant "Model" as Model
participant "TrainingPipelineBuilder" as PipelineBuilder
participant "TrainingPipeline" as TrainingPipeline
participant "CallbackManager" as CallbackManager


participant "FileManager" as FileManager

User -> Main: Start Training
Main -> Main: parse_args()
Main -> ConfigManager: Load Configurations
Main -> ExperimentManager: Load Hyperparameters

loop For each configuration
    Main -> DataManager: Preprocess Data
    Main -> Model: Initialize Model
    Main -> Model: Get Optimizer
    Main -> Model: Get Loss Function
    Main -> Model: Wrap Model

    Main -> CallbackManager: Initialize Callbacks


    Main -> PipelineBuilder: Build Training Pipeline
    PipelineBuilder -> TrainingPipeline: Create TrainingPipeline Instance

    loop For Each Epoch
      TrainingPipeline -> TrainingPipeline: Run Training Loop
    end

    TrainingPipeline -> FileManager: Save Trained Model
end


Main -> User: Notify Completion

@enduml

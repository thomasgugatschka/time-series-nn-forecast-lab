@startuml
skinparam rectangle {
    BackgroundColor Snow
    BorderColor Black
    ArrowColor Black
}

package "Cloud Environment" {
    rectangle "Data Ingestion & Management" as DIM {
        database "Raw Data Storage" as RDS
        frame "Data Selector" as DS {
            note right: Select relevant datasets
        }
        frame "Data Preprocessor" as DP {
            note right: Clean, normalize,\nand prepare data
        }
        frame "Dataset Splitter" as DSpl {
            note right: Split into training\nand testing datasets
        }
    }

    rectangle "Data Augmentation & Baseline" as DAB {
        database "Augmented Data" as AD
        frame "Baseline Data Generator" as BDG {
            note right: Generate data based on\ncommon statistics
        }
    }

    rectangle "Model Training & Validation" as MTV {
        rectangle "Docker Containers" as DC {
            component "[RNN Model]" as RNN
            component "[LSTM Model]" as LSTM
            component "[Transformer Model]" as TRF
            component "[VAEs Model]" as VAEs
            component "[GANs Model]" as GANs
            note right of DC : Each model in its own container
        }
        frame "Validation Set" as VS {
            note right: Validate model during training
        }
    }

    rectangle "CI/CD Pipeline" as CICD {
        frame "Continuous Integration" as CI {
            note right: Code and container updates
        }
        frame "Continuous Deployment" as CD {
            note right: Deploy updated models\nand configurations
        }
    }

    database "Model Storage & Versioning" as MSV {
        note right: Store different versions\nof models
    }

    rectangle "Testing, Monitoring & Evaluation" as TME {
        frame "Model Testing" as MT {
            note right: Test models with\nseparate test datasets
        }
        frame "Performance Monitoring" as PM {
            note right: Monitor model\nperformance metrics
        }
        database "Evaluation Results" as ER {
            note right: Store test results\nand metrics comparisons
        }
    }

    DIM -right-> DAB : Data for Augmentation
    DAB -down-> MTV : Augmented and\nBaseline Data
    DIM -down-> MTV : Train and Validation Data
    MTV --> MSV : Store Intermediate\nand Final Models
    MSV -right-> TME : Deploy Models for Testing
    CICD -up-> MTV : Update Models\nand Environments
    DIM --> TME : Test Data
    TME --> ER : Output Results
}

@enduml

# For Docker-Cloud
PROJECT_BASE_DIR=/app
USE_GCS=True
GCS_BUCKET=my-experiment-results


# Shared Configurations
LOCAL_MODE=True
LOG_LEVEL=INFO

PLOTS_SHOW=False
PLOTS_SAVE=True

#TkAgg, Qt5Agg, Agg
PLOTS_BACKEND_INTERACTIVE=TkAgg
PLOTS_BACKEND_NONINTERACTIVE=Agg
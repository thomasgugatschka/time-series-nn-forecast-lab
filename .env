# For Local Development
PROJECT_BASE_DIR=C:/Users/Thomas/localgit/time-series-nn-forecast-lab

# For Docker-Cloud
#PROJECT_BASE_DIR=/app



# ### SHARED CONFIGURATIONS ###
USE_GCS=True
GCS_BUCKET=forecast-lab-experiments

SYNC_CONFIG_FROM_GCS=False

LOCAL_MODE=True

PLOTS_SHOW=False
PLOTS_SAVE=True

# Needed to avoid issues when execution done through .bat file
#TkAgg, Qt5Agg, Agg
PLOTS_BACKEND_INTERACTIVE=TkAgg
PLOTS_BACKEND_NONINTERACTIVE=Agg

DISABLE_LOGGINGCALLBACK=False
DISABLE_EARLYSTOPPINGCALLBACK=False
DISABLE_PLOTTINGCALLBACK=False
DISABLE_TENSORBOARDCALLBACK=False
